total = 0

for i in range(1, 6):
    marks = float(input("Enter marks of subject " + str(i) + ": "))
    total = total + marks

percentage = (total / 500) * 100

if percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 50:
    grade = "D"
else:
    grade = "F"

if percentage >= 50:
    result = "Pass"
else:
    result = "Fail"

print("Total Marks:", total)
print("Percentage:", percentage, "%")
print("Grade:", grade)
print("Result:", result)
